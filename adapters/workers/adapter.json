{
  "$comment": "Cloudflare Workers adapter: stack rules, a wrangler dev --local verification driver, and npm/tsc/eslint/vitest checks. Reference example: examples/shortlinks. Same entry format as core/manifest.json.",
  "name": "workers",
  "description": "Cloudflare Workers (wrangler, D1, KV, R2, Queues, Durable Objects)",
  "requires": ["package.json", "wrangler.jsonc"],
  "agents": { "summary": "agents/summary.md", "map": "agents/map.md", "commands": "agents/commands.md", "rules": "agents/rules.md", "autonomy": "agents/autonomy.md" },
  "files": [
    { "src": ".cursor/rules/autonomy-workers.mdc", "mode": "managed", "phase": 0 },
    { "src": ".cursor/hooks/pstack-kit-guard.rules/workers.mjs", "mode": "managed", "phase": 0, "root": "git" },
    { "src": ".gitignore.workers", "dest": ".gitignore", "mode": "lines", "phase": 0 },

    { "src": ".cursor/skills/verify-{{projectName}}/driver.mjs", "mode": "managed", "phase": 1 },
    { "src": ".cursor/skills/verify-{{projectName}}/DRIVER.md", "mode": "managed", "phase": 1 },
    { "src": ".cursor/skills/verify-{{projectName}}/verify.config.json", "mode": "seed", "phase": 1 },
    { "src": ".cursor/skills/verify-{{projectName}}/smoke.json", "mode": "seed", "phase": 1 },
    { "src": ".cursor/skills/verify-{{projectName}}/features/README.md", "mode": "seed", "phase": 1 },
    { "src": ".cursor/skills/verify-{{projectName}}/features/health.md", "mode": "seed", "phase": 1 },
    { "src": ".pstack-kit/checks/workers.json", "mode": "managed", "phase": 1 },
    { "src": ".dev.vars.example", "mode": "seed", "phase": 1 },
    { "src": "tsconfig.kit.json", "mode": "managed", "phase": 1 },

    { "src": ".cursor/rules/workers.mdc", "mode": "managed", "phase": 2 },
    { "src": "eslint.workers.js", "mode": "managed", "phase": 2 },
    { "src": "scripts/kit/eslint-rules.mjs", "mode": "managed", "phase": 2 }
  ]
}
