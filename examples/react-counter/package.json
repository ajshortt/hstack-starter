{
  "name": "react-counter",
  "private": true,
  "version": "0.1.0",
  "description": "Example React (Vite) app with hstack-kit core and the react adapter applied: a counter and an about route, used to prove the react adapter's checks and Playwright-backed verification smoke.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "verify": "node .cursor/skills/verify-react-counter/control.mjs",
    "verify:smoke": "node .cursor/skills/verify-react-counter/control.mjs smoke",
    "check": "node scripts/kit/checks.mjs run --all"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "25.0.1",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  }
}
