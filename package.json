{
  "name": "hstack-kit",
  "version": "0.3.0",
  "private": true,
  "description": "Starter kit for adopting pstack (pinned at 0.15.36) in any repo: a stack-agnostic core plus optional stack adapters.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "hstack-kit": "bin/hstack-kit.mjs"
  },
  "files": [
    "bin",
    "lib",
    "core",
    "adapters",
    "vendor/pstack.lock.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "vendor:check": "node scripts/vendor-pstack.mjs check",
    "upstreams:check": "node scripts/upstreams.mjs check",
    "upstreams:report": "node scripts/upstreams.mjs report",
    "example:status": "node bin/hstack-kit.mjs status --target examples/shortlinks",
    "example:react:status": "node bin/hstack-kit.mjs status --target examples/react-counter"
  }
}
