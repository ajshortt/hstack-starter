{
  "name": "pstack-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Team starter kit for adopting pstack (pinned at 0.15.36) in Cloudflare Workers projects.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pstack-kit": "bin/pstack-kit.mjs"
  },
  "files": [
    "bin",
    "lib",
    "template",
    "vendor/pstack.lock.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "vendor:check": "node scripts/vendor-pstack.mjs check",
    "example:status": "node bin/pstack-kit.mjs status --target examples/shortlinks"
  }
}
